{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "traffic-sign-scanner": {
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/TrafficSignScanner.Mcp/TrafficSignScanner.Mcp.csproj"
      ],
      "env": {
        "TRAFFIC_SIGN_SCANNER_ROOT": "${workspaceFolder}"
      }
    }
  }
}
