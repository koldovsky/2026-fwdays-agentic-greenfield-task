# Стек у цьому завданні — будь-який. Додавай сюди ігнори свого стеку за потреби.

# OS / редактори
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Секрети / змінні середовища
.env
.env.*
!.env.example

# Залежності та артефакти збірки (типові для різних стеків)
node_modules/
dist/
build/
out/
.next/
__pycache__/
*.pyc
.venv/
venv/
target/
bin/
obj/

# EPUB test fixtures — regenerated by `tools/build_fixtures.py` per D-01.
# Only the generator script is committed; outputs are local-only.
backend/tests/fixtures/epubs/*.epub
!backend/tests/fixtures/epubs/.gitkeep

# Next.js static export — local-only; `yarn build` regenerates.
# Phase 2 / D-08: the demo flow rebuilds on every `docker compose up`.
frontend/out/

# Phase 1 Plan 01-03: runtime scratch dirs (SQLite WAL DB + artifact scratch).
# Both are overridable via EPUBTV_DB_PATH / EPUBTV_SCRATCH_DIR env vars.
# The docker-compose volume mounts them; `make demo` writes here too.
db/
scratch/

# Phase 1 Plan 01-03 Task 4: stray Playwright artefacts outside the configured
# output dir. The `frontend/` copies already cover in-tree runs.
playwright-report/
test-results/

# Phase 1 Plan 01-03: ignore stray video recordings NOT under docs/videos/.
# The committed deliverables (F1 / F2-F3 / F4 happy-path videos) live under
# docs/videos/ and are tracked via git-lfs or directly per D-05.
*.webm
!docs/videos/**/*.webm
