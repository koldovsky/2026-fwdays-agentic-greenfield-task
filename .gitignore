# Стек у цьому завданні — будь-який. Додавай сюди ігнори свого стеку за потреби.

# OS / редактори
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Секрети / змінні середовища
.env
.env.*
!.env.example

# Залежності та артефакти збірки (типові для різних стеків)
node_modules/
dist/
dist-frame/
build/
out/
.next/
__pycache__/
*.pyc
.venv/
venv/
target/
bin/
obj/

# Edda web toolchain
dev-dist/
coverage/
.fallow/
*.local

# Loop run artifacts (per-attempt gate evidence: notes/findings + playwright traces/videos/screenshots) —
# heavy and regenerated per run; the durable summaries live in loop/STATE.md and loop/impeccable/
loop/artifacts/
# per-run pointer symlink (target loop/runs/ is not tracked)
loop/latest
# Playwright MCP browser session dir (screenshots/traces) — generated by the browser tool, never source
.playwright-mcp/

# demo video artifacts (binary; regenerated by loop/impeccable/record-demo.mjs)
loop/impeccable/demo/

# test EPUB books (binary; several unit specs and the Komga seed read them from disk — keep locally)
test-epubs/
