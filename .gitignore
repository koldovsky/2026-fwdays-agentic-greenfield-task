# Стек у цьому завданні — будь-який. Додавай сюди ігнори свого стеку за потреби.

# OS / редактори
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Секрети / змінні середовища
.env
.env.*
!.env.example

# Залежності та артефакти збірки (типові для різних стеків)
node_modules/
dist/
build/
out/
.next/
__pycache__/
*.pyc
.venv/
venv/
target/
bin/
obj/

# Saved-page sidecar assets (CSS/JS/images from "Save As Complete Page") —
# the fixture .html itself is tracked; the parser never resolves these.
examples/*_files/

# Playwright E2E artifacts
test-results/
playwright-report/
.playwright/
app/demo/*.webm
