#!/usr/bin/env python3
"""check-traceability - requirement -> spec -> @trace test coverage gate.

Walks every requirement id that a ``docs/specs/`` slice claims to cover and looks
for a test carrying an ``@trace <ID>`` docstring annotation. A claimed requirement
with no ``@trace`` test is a GAP. Emits a generated, diff-safe matrix at
``docs/qa/traceability.md`` (no timestamps, POSIX paths, document-ordered).

This is the deterministic half only: it proves an *annotation* links a requirement
to a test. It does NOT judge whether the test meaningfully exercises the behavior -
that is graded later by a checker/judge pass.

Modes:
    (default)        Print a report; exit 1 if any claimed requirement is a GAP.
    --write          (Re)generate docs/qa/traceability.md. Exit 0.
    --check-fresh    Verify the committed matrix matches a fresh regenerate.
                     Exit 3 if stale. Freshness only - does not fail on GAPs, so a
                     known-and-recorded gap stays visible without blocking CI.

Exit codes: 0 ok / 1 gap(s) / 2 usage / 3 stale.
"""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _harness as H  # noqa: E402

MATRIX_PATH = "docs/qa/traceability.md"


def build_model() -> dict:
    root = H.repo_root()
    reqs = H.parse_requirements(root)
    specs = H.parse_specs(root)
    traces = H.parse_trace_tests(root)

    # requirement id -> sorted slice ids that claim to cover it
    claimed: dict[str, set[str]] = {}
    for spec in specs:
        for rid in spec.covered_ids:
            claimed.setdefault(rid, set()).add(spec.slice_id)

    claimed_ids = sorted(claimed, key=lambda r: H.sort_key(r, reqs))
    rows = []
    gaps = []
    for rid in claimed_ids:
        tests = traces.by_id.get(rid, [])
        covered = bool(tests)
        if not covered:
            gaps.append(rid)
        rows.append(
            {
                "id": rid,
                "coverage": "COVERED" if covered else "GAP",
                "slices": ",".join(sorted(claimed[rid])),
                "tests": tests,
            }
        )

    unclaimed = sorted(
        (rid for rid in reqs if rid not in claimed and reqs[rid].status != "dropped"),
        key=lambda r: H.sort_key(r, reqs),
    )
    return {
        "rows": rows,
        "gaps": gaps,
        "claimed_count": len(claimed_ids),
        "unclaimed": unclaimed,
    }


def render_matrix(model: dict) -> str:
    lines: list[str] = []
    lines.append("# Traceability matrix")
    lines.append("")
    lines.append(
        "Generated by `scripts/check-traceability` - do not edit by hand. Regenerate "
        "with `python scripts/check-traceability --write` (the pre-commit hook does "
        "this automatically and self-stages the result)."
    )
    lines.append("")
    lines.append(
        "Every requirement a `docs/specs/` slice claims to cover is mapped to the "
        "test(s) carrying its `@trace <ID>` docstring annotation. A row marked **GAP** "
        "has a spec claim but no `@trace` test yet. This gate proves the annotation "
        "link only, not that the test exercises the behavior (a later checker/judge "
        "pass grades that)."
    )
    lines.append("")
    lines.append("## Coverage of spec-claimed requirements")
    lines.append("")
    lines.append("| Requirement | Coverage | Slice(s) | Trace test(s) |")
    lines.append("| --- | --- | --- | --- |")
    for row in model["rows"]:
        tests = "<br>".join(row["tests"]) if row["tests"] else "(none)"
        lines.append(f"| {row['id']} | {row['coverage']} | {row['slices']} | {tests} |")
    lines.append("")
    traced = model["claimed_count"] - len(model["gaps"])
    lines.append(
        f"Summary: {model['claimed_count']} claimed, {traced} traced, "
        f"{len(model['gaps'])} gap."
    )
    lines.append("")
    lines.append("## Requirements not yet claimed by any spec")
    lines.append("")
    lines.append("Informational - these await a future slice; not counted as gaps.")
    lines.append("")
    if model["unclaimed"]:
        for rid in model["unclaimed"]:
            lines.append(f"- {rid}")
    else:
        lines.append("- (none)")
    return "\n".join(lines)


def main(argv: list[str]) -> int:
    mode = "report"
    for arg in argv:
        if arg in ("--write", "--check-fresh", "--report"):
            mode = arg.lstrip("-")
        elif arg in ("-h", "--help"):
            print(__doc__)
            return H.EXIT_OK
        else:
            print(f"check-traceability: unknown argument {arg!r}", file=sys.stderr)
            return H.EXIT_USAGE

    root = H.repo_root()
    model = build_model()
    content = render_matrix(model)
    path = root / MATRIX_PATH
    traced = model["claimed_count"] - len(model["gaps"])

    if mode == "write":
        H.write_generated(path, content)
        print(
            f"check-traceability: wrote {MATRIX_PATH} "
            f"({model['claimed_count']} claimed, {traced} traced, {len(model['gaps'])} gap)"
        )
        return H.EXIT_OK

    if mode == "check-fresh":
        fresh, diff = H.check_fresh(path, content)
        if fresh:
            print(f"check-traceability: {MATRIX_PATH} is fresh.")
            return H.EXIT_OK
        print(f"check-traceability: {MATRIX_PATH} is STALE - regenerate with "
              f"`python scripts/check-traceability --write`.", file=sys.stderr)
        print(diff, file=sys.stderr)
        return H.EXIT_STALE

    # default: report + enforce
    print(
        f"check-traceability: {model['claimed_count']} claimed, {traced} traced, "
        f"{len(model['gaps'])} gap."
    )
    if model["gaps"]:
        print("\nGAP - spec-claimed requirements with no @trace test:")
        # group gaps with their slices for a readable, actionable report
        slice_of = {row["id"]: row["slices"] for row in model["rows"]}
        for rid in model["gaps"]:
            print(f"  - {rid} (slice {slice_of[rid]})")
        print(
            "\nAdd an `@trace <ID>` line to the covering test's docstring, then run "
            "`python scripts/check-traceability --write`."
        )
        return H.EXIT_CHECK_FAILED
    print("All spec-claimed requirements have an @trace test.")
    return H.EXIT_OK


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
