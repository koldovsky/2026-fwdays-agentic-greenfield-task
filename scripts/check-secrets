#!/usr/bin/env python3
"""check-secrets - block committing secrets or a real .env file.

A deterministic, conservative scanner (no entropy heuristics, to keep it
false-positive-light). It flags:
  * staging a real dotenv file (.env, .env.local, ...) - only *.env.example is allowed;
  * high-confidence secret tokens (private keys, AWS/Google/GitHub/Slack tokens);
  * a secret-looking assignment (password/secret/token/api_key = "<12+ chars>"),
    except obvious placeholders and inside *.example files.

Used by the pre-commit hook. By default it scans the STAGED content
(`git diff --cached`); pass explicit paths to scan working-tree files instead.

Exit codes: 0 clean / 1 finding(s) / 2 usage.
"""

from __future__ import annotations

import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _harness as H  # noqa: E402

# High-confidence patterns - never legitimate, even in an example file.
HARD_PATTERNS = [
    ("private key block", re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----")),
    ("AWS access key id", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z_\-]{35}\b")),
    ("GitHub token", re.compile(r"\bgh[pousr]_[0-9A-Za-z]{36,}\b")),
    ("Slack token", re.compile(r"\bxox[baprs]-[0-9A-Za-z-]{10,}\b")),
    # NB: deliberately no bare "long hex" rule - it false-positives on git SHAs and
    # subresource-integrity / lockfile hashes, which would block legitimate commits.
]

# Secret-looking assignment; softer, so it is skipped in *.example files and for
# obvious placeholder values.
ASSIGN_RE = re.compile(
    r"""(?ix)
    \b(password|passwd|secret|secret[_-]?key|token|api[_-]?key|access[_-]?key|
       client[_-]?secret|private[_-]?key)\b
    \s*[:=]\s*
    (?P<q>["'])(?P<val>[^"']{12,})(?P=q)
    """
)
PLACEHOLDER_RE = re.compile(
    r"(?i)(change[-_ ]?me|changeme|example|your[-_ ]|xxx+|<[^>]+>|dummy|placeholder|"
    r"redacted|todo|\.\.\.|secret[-_ ]?here|s3cr3t)"
)
DOTENV_RE = re.compile(r"(^|/)\.env(\.[^/]*)?$")
EXAMPLE_RE = re.compile(r"(\.example$|\.env\.example$)")
# Binary / vendored / lockfile paths we never scan.
SKIP_PATH_RE = re.compile(
    r"(^|/)(node_modules|\.venv|dist|build|__pycache__)/|"
    r"(package-lock\.json|\.png|\.jpg|\.gif|\.ico|\.woff2?)$"
)


def staged_files(root) -> list[str]:
    proc = H.git(root, "diff", "--cached", "--name-only", "--diff-filter=ACM")
    return [f for f in proc.out.splitlines() if f.strip()]


def staged_content(root, path: str) -> str | None:
    proc = H.git(root, "show", f":{path}")
    if proc.code != 0:
        return None
    return proc.out


def is_placeholder(val: str) -> bool:
    if PLACEHOLDER_RE.search(val):
        return True
    if len(set(val)) <= 2:  # "aaaaaaaaaaaa", "xxxxxxxxxxxx"
        return True
    return False


def scan_text(path: str, text: str) -> list[str]:
    findings: list[str] = []
    is_example = bool(EXAMPLE_RE.search(path))
    for i, line in enumerate(text.splitlines(), start=1):
        for label, pat in HARD_PATTERNS:
            if pat.search(line):
                findings.append(f"{path}:{i}: {label}")
        if not is_example:
            m = ASSIGN_RE.search(line)
            if m and not is_placeholder(m.group("val")):
                findings.append(f"{path}:{i}: secret-looking assignment to "
                                f"`{m.group(1)}`")
    return findings


def main(argv: list[str]) -> int:
    root = H.repo_root()
    explicit = [a for a in argv if not a.startswith("-")]
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__)
        return H.EXIT_OK

    findings: list[str] = []

    if explicit:
        targets = [(p, None) for p in explicit]
    else:
        targets = [(p, "staged") for p in staged_files(root)]

    for path, source in targets:
        norm = path.replace("\\", "/")
        # A real dotenv file must never be committed (example files are fine).
        if DOTENV_RE.search(norm) and not EXAMPLE_RE.search(norm):
            findings.append(f"{norm}: real dotenv file staged - only *.env.example "
                            "may be committed")
            continue
        if SKIP_PATH_RE.search(norm):
            continue
        if source == "staged":
            text = staged_content(root, path)
        else:
            full = root / path
            if not full.is_file():
                continue
            try:
                text = full.read_text(encoding="utf-8")
            except (UnicodeDecodeError, OSError):
                continue
        if text is None:
            continue
        findings += scan_text(norm, text)

    if findings:
        print("check-secrets: potential secret(s) detected - commit blocked:",
              file=sys.stderr)
        for f in findings:
            print(f"  - {f}", file=sys.stderr)
        print("\nRemove the secret (use a *.env.example placeholder and load real "
              "values from the environment). If this is a false positive, scope the "
              "value or adjust scripts/check-secrets.", file=sys.stderr)
        return H.EXIT_CHECK_FAILED
    return H.EXIT_OK


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
