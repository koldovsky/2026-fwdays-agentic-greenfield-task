# Honeydo mobile — Expo public env (EXPO_PUBLIC_* is inlined into the app bundle).
# Copy to .env for local device testing.

# API base URL. On a SIMULATOR you can use http://localhost:3333.
# On a PHYSICAL DEVICE use your Mac's LAN IP (run: ipconfig getifaddr en0),
# and make sure the phone is on the same Wi-Fi. Never "localhost" on a real phone.
EXPO_PUBLIC_API_URL=http://localhost:3333

# Google OAuth client id for expo-auth-session. Blank hides the Google button.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
