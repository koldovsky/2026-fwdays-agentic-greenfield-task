# Honeydo API environment. Copy to .env and fill in.
# Postgres connection string used by Prisma (see prisma/schema.prisma).
# Port 5434 matches docker-compose.yml (mapped to avoid local Postgres clashes).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/honeydo?schema=public"

# HTTP port the Nest server listens on (defaults to 3333; :3000 is often taken).
PORT=3333

# --- Auth (add-auth) ---
# Secret for signing access JWTs. Use a long random string in real environments.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
# Token lifetimes (zeit/ms format for access; days for refresh).
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"
# Google OAuth 2.0 (server verifies the client's id_token). Leave blank to disable
# Google sign-in locally.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
