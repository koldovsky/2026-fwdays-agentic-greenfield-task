// Honeydo API — Prisma schema. The Prisma client lives ONLY in apps/api
// (see AGENTS.md). Models map to the @honeydo/shared API contracts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A single tracked time entry. `stoppedAt`/`durationSec` are null while running.
model TimeEntry {
  id          String    @id @default(cuid())
  note        String
  startedAt   DateTime  @default(now())
  stoppedAt   DateTime?
  durationSec Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startedAt])
}
