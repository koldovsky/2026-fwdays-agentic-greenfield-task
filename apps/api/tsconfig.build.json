{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Disable incremental for builds: nest-cli's `deleteOutDir` wipes dist/ but not
    // the .tsbuildinfo (which lives outside dist), so an incremental rebuild would
    // trust the stale info and emit nothing — leaving `dist/main` missing. Full emit
    // every build keeps `nest start`/`start:prod` reliable.
    "incremental": false
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
