#!/usr/bin/env python3
"""stop-verify - Stop hook: run the backend test subset for the touched modules.

At the end of a turn this looks at what changed versus HEAD, and if any backend
Python changed it runs the mapped pytest subset (each changed ``app/<name>.py`` ->
``tests/test_<name>.py`` when that file exists, plus any changed test files; falls
back to the whole backend suite if nothing maps). If a real Postgres is reachable it
sets ``RUN_DB_TESTS=1`` so the DB-gated tests actually run; otherwise those skip and
that is noted rather than failing spuriously.

On a test failure it writes a short tail to stderr and exits 2, which Claude Code
surfaces to the model so it can fix the regression before ending. If nothing backend
changed, or the environment is not set up, it exits 0 quietly. It reuses the repo's
own pytest invocation; it defines no new checks.

This hook is opt-in and blocking by design (see .claude/hooks/README.md). It never
invents work: no touched backend module -> no-op.
"""

from __future__ import annotations

import json
import os
import socket
import subprocess
import sys
from pathlib import Path

OK, FEEDBACK = 0, 2


def project_root(data: dict) -> Path:
    return Path(os.environ.get("CLAUDE_PROJECT_DIR") or data.get("cwd") or os.getcwd())


def venv_python(root: Path) -> str:
    for c in (
        root / "backend" / ".venv" / "Scripts" / "python.exe",
        root / "backend" / ".venv" / "bin" / "python",
    ):
        if c.is_file():
            return str(c)
    return sys.executable


def changed_files(root: Path) -> list[str]:
    try:
        proc = subprocess.run(
            ["git", "-C", str(root), "status", "--porcelain"],
            capture_output=True, text=True,
        )
    except OSError:
        return []
    files: list[str] = []
    for line in proc.stdout.splitlines():
        entry = line[3:] if len(line) > 3 else ""
        entry = entry.strip().strip('"')
        if "->" in entry:  # rename: keep the destination
            entry = entry.split("->")[-1].strip()
        if entry:
            files.append(entry.replace("\\", "/"))
    return files


def select_tests(root: Path, backend_py: list[str]) -> list[str]:
    """Map changed backend files to backend-relative test paths (deterministic)."""
    tests_dir = root / "backend" / "tests"
    selected: set[str] = set()
    for f in backend_py:
        name = Path(f).name
        if f.startswith("backend/tests/") and name.startswith("test_"):
            selected.add(f[len("backend/"):])
            continue
        candidate = tests_dir / f"test_{Path(f).stem}.py"
        if candidate.is_file():
            selected.add(f"tests/test_{Path(f).stem}.py")
    return sorted(selected)


def db_reachable(host: str = "127.0.0.1", port: int = 5432, timeout: float = 0.4) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def tail(text: str, n: int) -> str:
    lines = text.splitlines()
    return "\n".join(lines[-n:])


def main() -> int:
    try:
        data = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        data = {}

    root = project_root(data)
    changed = changed_files(root)
    backend_py = [f for f in changed if f.startswith("backend/") and f.endswith(".py")]
    if not backend_py:
        return OK  # nothing backend-y changed; stay silent

    py = venv_python(root)
    backend = root / "backend"
    probe = subprocess.run(
        [py, "-c", "import pytest"], cwd=str(backend),
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    if probe.returncode != 0:
        return OK  # backend env not installed; nothing to do

    tests = select_tests(root, backend_py)
    env = dict(os.environ)
    if db_reachable():
        env["RUN_DB_TESTS"] = "1"
        db_note = ""
    else:
        env.pop("RUN_DB_TESTS", None)
        db_note = " (Postgres unreachable: DB-gated tests skipped)"

    cmd = [py, "-m", "pytest", "-q", *tests]
    scope = " ".join(tests) if tests else "full backend suite (no per-module mapping)"
    proc = subprocess.run(cmd, cwd=str(backend), env=env, capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(f"stop-verify: backend tests FAILED{db_note}.\n")
        sys.stderr.write(f"scope: {scope}\n")
        sys.stderr.write(tail((proc.stdout or "") + (proc.stderr or ""), 60))
        sys.stderr.write("\nFix the failing test(s) before ending the session.\n")
        return FEEDBACK

    print(f"stop-verify: backend test subset passed{db_note} [{scope}].")
    return OK


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception as exc:  # never break the session on a hook bug
        sys.stderr.write(f"stop-verify: internal error (ignored): {exc}\n")
        raise SystemExit(0)
