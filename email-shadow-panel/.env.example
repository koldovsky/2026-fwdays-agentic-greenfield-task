EMAILNATOR_PROBE_ENABLED=false
PHASE0_PROBE_TOKEN=replace-with-an-internal-preview-only-bearer-token
PHASE0_SESSION_KEY=replace-with-a-high-entropy-secret-for-phase0-session-capsules
SESSION_ENCRYPTION_KEY=replace-with-a-32-byte-base64url-or-64-hex-session-encryption-key
VISITOR_HASH_KEY=replace-with-a-32-byte-base64url-or-64-hex-visitor-hash-key
SESSION_TTL_SECONDS=900
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-redis-rest-token
REDIS_KEY_NAMESPACE=email-shadow-panel
