# Copy this file to `.env` (in test/komga/) to override any value below.
# Everything is optional — without a .env the compose defaults (identical to
# these) are used. `.env` is gitignored; `.env.example` is committed.

# --- Komga server ---
# KOMGA_IMAGE=gotson/komga:1.24.4   # pin a version for reproducible runs
# KOMGA_PORT=25600                  # host port -> http://localhost:<port>
# TZ=Europe/Kyiv
# Browser fetch is cross-origin -> the server must allowlist the app origin (host concern, not the
# plugin's). Comma-separated; default covers Vite dev (:5173) + preview (:4173) + the reader-frame
# origin (:5174, ADR-013). Node integration tests don't need it.
# KOMGA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# --- Credentials provisioned into Komga ---
# Admin — created via the claim endpoint on first run:
KOMGA_ADMIN_EMAIL=admin@edda.test
KOMGA_ADMIN_PASSWORD=edda-admin-pw

# Reader — non-admin account the connector should authenticate as in tests:
KOMGA_USER_EMAIL=reader@edda.test
KOMGA_USER_PASSWORD=edda-reader-pw

# --- Library ---
# KOMGA_LIBRARY_NAME=Test EPUBs
