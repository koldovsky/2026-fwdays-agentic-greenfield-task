{
  "name": "sport-nutrition-coach-bot",
  "version": "0.0.0",
  "private": true,
  "description": "Telegram bot — personal cutting/nutrition coach. Postgres is source of truth; Notion is a best-effort mirror.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "evals": "tsx evals/run.ts",
    "check:evals": "node scripts/check-eval-ratchet.mjs",
    "docs:check": "node scripts/check-docs-sync.mjs --check",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@prisma/client": "^6.19.3",
    "grammy": "^1.30.0",
    "prisma": "^6.19.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^4.1.9"
  }
}
