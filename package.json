{
  "name": "honeydo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile": "npm run start -w @honeydo/mobile",
    "api": "npm run start -w @honeydo/api", 
    "migrate": "npm run prisma:migrate -w @honeydo/api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v"
  }
}
