{
  "name": "hryvnia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:trace": "node scripts/check-traceability.mjs",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "npm run lint && npm run check:trace && npm run spec:validate && npm run build"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
