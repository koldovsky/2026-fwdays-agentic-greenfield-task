{
  "name": "edda",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:frame": "vite --config vite.frame.config.ts",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.frame.config.ts",
    "build:frame": "vite build --config vite.frame.config.ts",
    "preview": "vite preview",
    "preview:frame": "vite preview --config vite.frame.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:a11y": "playwright test --project=a11y",
    "test:responsive": "playwright test --project=responsive",
    "test:komga": "playwright test --project=komga-e2e",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "fallow",
    "audit": "pnpm audit --audit-level moderate",
    "audit:ci": "audit-ci --config audit-ci.jsonc",
    "komga:up": "docker compose -f test/komga/docker-compose.yml up -d",
    "komga:provision": "docker compose -f test/komga/docker-compose.yml run --rm provision",
    "komga:logs": "docker compose -f test/komga/docker-compose.yml logs -f",
    "komga:down": "docker compose -f test/komga/docker-compose.yml down",
    "komga:reset": "docker compose -f test/komga/docker-compose.yml down -v"
  },
  "dependencies": {
    "@pinia/colada": "^1.3.1",
    "@readium/shared": "^2.2.3",
    "dexie": "^4.4.4",
    "pdfjs-dist": "^6.1.200",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/literata": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "audit-ci": "^7.1.0",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.9.2",
    "fake-indexeddb": "^6.2.5",
    "fallow": "^2.103.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
