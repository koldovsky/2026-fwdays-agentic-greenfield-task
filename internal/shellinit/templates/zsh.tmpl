# ctxline shell integration (zsh) — eval "$({{.Cmd}} init zsh)"
if [ -z "${__CTXLINE_ZSH_LOADED:-}" ]; then
  __CTXLINE_ZSH_LOADED=1
  __CTXLINE_ORIG_PROMPT="$PROMPT"

  __ctxline_precmd() {
    local __ctxline_seg
    __ctxline_seg="$({{.Cmd}} --shell zsh)"
    if [ -n "$__ctxline_seg" ]; then
      PROMPT="${__ctxline_seg} ${__CTXLINE_ORIG_PROMPT}"
    else
      PROMPT="${__CTXLINE_ORIG_PROMPT}"
    fi
  }

  if [[ -z "${precmd_functions[(r)__ctxline_precmd]}" ]]; then
    precmd_functions+=(__ctxline_precmd)
  fi

  ctxon()  { export CTXLINE_ENABLED=true; }
  ctxoff() { export CTXLINE_ENABLED=false; }
  ctxtoggle() {
    if [ "${CTXLINE_ENABLED:-true}" = "true" ]; then
      export CTXLINE_ENABLED=false
    else
      export CTXLINE_ENABLED=true
    fi
  }
fi
