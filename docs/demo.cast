[0.112, "o", "\r\n\u001b[1;32m== tf-guard — keyless, offline terraform plan risk linter ==\u001b[0m\r\n"]
[1.325, "o", "built: spec -> failing tests -> green -> eval -> independent review\r\n"]
[1.225, "o", "\r\n\u001b[1;32m== 1. Deterministic core — verified by TESTS ==\u001b[0m\r\n"]
[1.323, "o", "\r\n\u001b[1;35m$ npm test\u001b[0m\r\n"]
[1.456, "o", "# pass 28\r\n# fail 0\r\n# cancelled 0\r\n# skipped 0\r\n# todo 0\r\n# duration_ms 259.879333\r\n"]
[1.424, "o", "\r\n\u001b[1;32m== 2. Summary surface — verified by EVALS (rubric + ratchet, no exact equality) ==\u001b[0m\r\n"]
[1.330, "o", "\r\n\u001b[1;35m$ npm run eval\u001b[0m\r\n"]
[1.433, "o", "\\"]
[0.004, "o", "\u001b[1G"]
[0.000, "o", "\u001b[0K"]
[0.371, "o", "eval: 100.0% (35/35) over 7 cases\r\neval: PASS\r\n"]
[0.008, "o", "\\"]
[0.002, "o", "\u001b[1G\u001b[0K"]
[1.425, "o", "\r\n\u001b[1;32m== 3. Run it on a sample plan ==\u001b[0m\r\n"]
[1.321, "o", "\r\n\u001b[1;35m$ tf-guard tests/fixtures/plan-mixed.json\u001b[0m\r\n"]
[1.642, "o", "tf-guard — 2 high, 0 medium, 3 low · 5 changes\r\n[HIGH] 90 aws_db_instance.main — delete of stateful resource\r\n[HIGH] 90 aws_s3_bucket.assets — replace of stateful resource\r\n[LOW ] 25 aws_instance.worker — missing tags: owner\r\n2 changes with no policy findings.\r\n"]
[0.008, "o", "\\"]
[0.002, "o", "\u001b[1G\u001b[0K"]
[0.004, "o", "\r\n\u001b[1;33mexit code: 1\u001b[0m  (1 = high risk -> gates CI, BC-EXIT-01)\r\n"]
