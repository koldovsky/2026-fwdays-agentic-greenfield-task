{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:e2e": "cross-env TICKET2MD_E2E=1 npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:demo": "npm run build:e2e && playwright test && node scripts/export-demo-video.mjs",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@picocss/pico": "^2.1.1",
    "@playwright/test": "^1.61.1",
    "cross-env": "^7.0.3",
    "@types/chrome": "^0.2.2",
    "@types/jsdom": "^28.0.3",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "turndown": "^7.2.4"
  }
}
