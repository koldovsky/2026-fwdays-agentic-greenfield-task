{
  "name": "back-end",
  "version": "0.1.0",
  "private": true,
  "description": "Back-end service (Fastify + TypeScript).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts | pino-pretty",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "discover": "tsx scripts/discover-tvs.ts",
    "pair": "tsx scripts/pair-tv.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "@fastify/websocket": "^11.0.2",
    "bonjour-service": "^1.4.2",
    "fast-xml-parser": "^5.9.3",
    "fastify": "^5.2.0",
    "node-ssdp": "^4.0.1",
    "p-queue": "^9.3.1",
    "pino": "^9.6.0",
    "undici": "^8.7.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-ssdp": "^4.0.5",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
