# Copy this file to backend/.env for local development.
# backend/.env is git-ignored; never commit real secrets.

ENVIRONMENT=development

# Async SQLAlchemy URL (asyncpg driver). Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# Comma-separated CORS origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# --- Authentication (slice 001-auth-email) ---
# Application secret for token/OAuth-state signing. Generate a real random value
# in every non-dev environment, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=dev-insecure-change-me

# Session cookie. Set SESSION_COOKIE_SECURE=true wherever the app is served over HTTPS
# (required by browsers for SameSite=None). Leave false for local http dev.
SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_NAME=cadence_session
# SESSION_COOKIE_SAMESITE=none
# SESSION_TTL_DAYS=30
# CSRF_COOKIE_NAME=cadence_csrf
# CSRF_HEADER_NAME=X-CSRF-Token
# BCRYPT_ROUNDS=12

# --- AI coach (slice 006-coach) ---
# Google AI Studio API key for the Gemma coach (TC-LLM-01). Create one at
# https://aistudio.google.com/apikey (free tier, one owner key — NFR-COST-01).
# Leave blank to run without the coach: it degrades gracefully to a deterministic
# fallback (NFR-REL-01). NEVER commit a real key — backend/.env is git-ignored.
GOOGLE_AI_API_KEY=
