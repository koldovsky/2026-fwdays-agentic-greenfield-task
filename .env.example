# Vouch environment — copy to `.env.local` and fill in. NEVER commit real values.
# Server env is read lazily (src/shared/config/env.ts); a required-but-missing
# var throws on first use, not at import.

# --- Database (required for any DB access) ---
# Local dev: `yarn dev:db` serves in-memory PGlite on 5544.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5544/postgres
# TLS: require | true | on | no-verify | disable | false | off. Default: on in prod.
DATABASE_SSL=disable

# Point the DB-integration suite (`yarn test:pg`) at a REAL Postgres to check
# PGlite-vs-Postgres parity. Leave UNSET to run those tests on in-process PGlite.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# --- Auth (required) ---
# next-auth v5 JWT signing secret. Generate: `openssl rand -base64 32`.
AUTH_SECRET=

# --- Crypto (required) ---
# AES-256-GCM key for CV-at-rest (NFR-SEC-01). 32 bytes, hex or base64.
# Generate: `openssl rand -hex 32`.
CV_ENCRYPTION_KEY=

# --- LLM (required for live tailoring) ---
ANTHROPIC_API_KEY=
# LLM_PROVIDER=claude          # claude (default) | chatgpt
# OPENAI_API_KEY=              # only when LLM_PROVIDER=chatgpt
# LLM_MODEL=                   # optional model override
# COVERAGE_JUDGE=on            # default on, key-gated; opt out with 0/false/off

# --- Payments (emulator only; Stripe is spec-only / hard-disabled in prod) ---
PAYMENTS_PROVIDER=emulator
# HMAC secret for checkout-token + webhook signatures (required).
PAYMENTS_WEBHOOK_SECRET=

# --- Ops ---
# Bearer secret for POST /api/maintenance/tailoring-cleanup (required for the cron).
MAINTENANCE_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
