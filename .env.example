# Session signing secret — set in production
COLIBRI_SESSION_SECRET=change-me-in-production

# Set false for HTTP STG (nip.io); true when served over HTTPS
# COLIBRI_COOKIE_SECURE=false
# COLIBRI_PUBLIC_URL=http://colibri.64.225.115.88.nip.io

# Booking submit mode: stub | live
COLIBRI_SUBMIT_MODE=stub

# Cron secret for POST /api/booking/schedule/run (system cron on droplet)
COLIBRI_CRON_SECRET=change-me-in-production

# Persistent data dir on server (scheduled jobs, users)
# COLIBRI_DATA_DIR=/var/lib/colibri-book

# Login accounts: copy .secret.example → .secret (gitignored)
