# Kolo360 environment configuration. Copy to `.env` and fill in real values.
# Secrets live only in server-side env, never in the client bundle (NFR-SEC-02).
# No managed Postgres is provisioned yet (foundation slice); these are the
# variables the app and Prisma will read once a database exists (TC-DEPLOY-01).

# Pooled Postgres connection used at runtime by the Prisma driver adapter.
DATABASE_URL="postgresql://user:password@host:5432/kolo360?schema=public"

# Direct (non-pooled) connection used by Prisma CLI for migrations. With a
# pooled provider (Neon, Supabase, Vercel Postgres) this points at the direct
# endpoint; with a plain Postgres it can equal DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/kolo360?schema=public"

# ── Auth (slice add-auth) ──────────────────────────────────────────────────
# Secret used to sign/verify the short-lived access-token JWT (HS256). Server
# side only; never shipped to the client (NFR-SEC-02). Min 32 chars. Generate
# one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional token lifetimes (defaults: access 15m, refresh 7d). Accept a value
# like "15m", "7d", "12h" or a number of seconds.
# AUTH_ACCESS_TTL=15m
# AUTH_REFRESH_TTL=7d

# The single HR account is NOT configured here — its credentials live in the
# HrUser table (email + scrypt password hash), provisioned by an administrator
# with `node scripts/create-hr-user.mts <email> <password> [name]` (FR-AUTH-02).
