# Copy to .env.local for local dev. .env.local is gitignored — never commit it.

# SQLite datastore (ADR-0001). A `file:` URL or bare path; ":memory:" for tests.
# Defaults to file:./data/app.db when unset.
DATABASE_URL=file:./data/app.db

# No auth, email, or third-party integrations in MVP (TC-04) — no other secrets.
