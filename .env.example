# Application defaults (override as needed)
TIMESTAMP_INTERVAL_SECONDS=15
LIVE_BEFORE_MINUTES=3
LIVE_AFTER_MINUTES=3
MAX_CHUNK_DURATION_SECONDS=60
SILENCE_DETECTION_ENABLED=true
STT_PROVIDER=openai
STT_MODEL=whisper-1
OUTPUT_DIR=output
SAVE_DEBUG_AUDIO=false

SUBTITLE_PREFERRED_LANGUAGES=uk,en,ru
OPENAI_API_KEY=

# Optional: Hugging Face provider (set STT_PROVIDER=huggingface)
HUGGINGFACE_API_TOKEN=
