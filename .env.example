# Kamerton — local secrets (copy to .env; .env is gitignored, gitleaks guards commits)

# Telegram bot token from @BotFather (NFR-SEC-01)
TELEGRAM_BOT_TOKEN=123456:replace-me

# DEMO Google Calendar (TC-CAL-01, ADR-0003): share the calendar with the
# service account ("Make changes"), put its JSON key under secrets/ (gitignored)
# and chmod 600 the key file (review-gate hardening).
GOOGLE_CALENDAR_ID=your-demo-calendar-id@group.calendar.google.com
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# Anthropic: NO API key here by design (NFR-SEC-01) — auth resolves from the
# developer's local user token: `ant auth login` profile / ANTHROPIC_AUTH_TOKEN.

# Local SQLite file the bot opens on start (TC-DATA-01; *.db is gitignored).
# Optional — defaults to ./kamerton.db when unset.
KAMERTON_DB_PATH=./kamerton.db
