# Telegram Bot
TELEGRAM_BOT_TOKEN=

# OpenAI
OPENAI_API_KEY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=tracker_user
DB_PASSWORD=
DB_NAME=expense_tracker

# Environment
ENVIRONMENT=development

# LangSmith (optional — explicit opt-in for LLM tracing)
# Leave LANGSMITH_API_KEY empty to disable tracing (default: disabled)
# Set LANGSMITH_API_KEY to enable tracing at smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=expense-tracker

