#!/bin/sh
# Harness pre-commit gate: secrets scan + ruff (staged backend) + refresh & stage
# the trace matrices. Delegates to scripts/pre-commit-run (cross-platform Python).
# Enable with:  git config core.hooksPath .githooks   (see .githooks/README.md)
PY="$(command -v python 2>/dev/null || command -v python3 2>/dev/null)"
if [ -z "$PY" ]; then
  echo "pre-commit: python not found on PATH; skipping harness gate." >&2
  exit 0
fi
exec "$PY" scripts/pre-commit-run
